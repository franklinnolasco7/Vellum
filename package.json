{
  "name": "vivant",
  "description": "An open-source E-Book reader for Linux. Built with Tauri.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build:linux": "tauri build --bundles deb,rpm",
    "build:release": "npm run build && cargo build --release --manifest-path src-tauri/Cargo.toml",
    "run:release": "./src-tauri/target/release/Vivant",
    "start:arch": "npm run build:release && npm run run:release",
    "test": "vitest run",
    "version:sync": "node scripts/sync-version.js",
    "version": "node scripts/bump-version.js"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-fs": "^2.0.0"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@tauri-apps/cli": "^2",
    "esbuild": "^0.28.0",
    "semantic-release": "^25.0.3",
    "terser": "^5.46.1",
    "vite": "^8",
    "vitest": "^4"
  }
}
